# Safarnama Environment Configuration
# Copy this file to .env and fill in your keys

PORT=3001

# Gemini AI API Key (REQUIRED for server-side AI replanning, group generation, and budget intelligence)
# Get your key at: https://aistudio.google.com/app/apikey
# Note: This key is strictly called server-side and NEVER exposed to the browser client.
GEMINI_API_KEY=your_gemini_api_key_here

# Supabase Configuration (Optional for cloud sync; local storage mode works offline automatically)
# Get these from your Supabase project dashboard -> Settings -> API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Email / Notification Provider (Optional - Resend API)
RESEND_API_KEY=re_your_resend_api_key_here
